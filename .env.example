# OpenAI-compatible provider configuration (live path). These variables are
# read by packages/providers/openai.py when no explicit kwargs are provided.
OPENAI_BASE_URL=http://<sglang-host>:30000/v1
OPENAI_API_KEY=empty
REQUEST_TIMEOUT=120

# Model alias for the vLLM provider fallback and the integration-test skip
# gate (tests/integration/test_gateway_to_vllm.py). Must match a served model.
DEFAULT_MODEL=qwen38-27b

# vLLM alternate/historical backend. Uncomment when routing to provider "vllm".
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_API_KEY=empty

# Gateway settings. These variables are read by Pydantic Settings with the
# APP_ prefix.
APP_LOG_LEVEL=INFO
APP_DEFAULT_PROVIDER=openai
APP_DEFAULT_MODEL=qwen38-27b
APP_REPOSITORY_PATH=.
APP_REPOSITORY_CONTEXT_ENABLED=true
APP_REPOSITORY_CONTEXT_MAX_TOKENS=4096
APP_REPOSITORY_CONTEXT_INTENT_BUDGETS=SEARCH:2048,TEST:2048,DEBUG:2048,REFACTOR:4096,IMPLEMENT:4096,EXPLAIN:4096
APP_REPOSITORY_EXCLUDE_TESTS=false
APP_REPOSITORY_EXCLUDE_GLOBS=scripts/**
APP_CONTEXT_DELTA_INJECTION=true
APP_CONTEXT_DELTA_CACHE_SIZE=256
APP_CONTEXT_INTENT_RULES={}
APP_SESSION_LOG_ENABLED=true
APP_SESSION_LOG_PATH=logs/sessions.jsonl
APP_HISTORY_CAP_ENABLED=true
APP_HISTORY_CAP_TOKENS=10000

# Quality harness reasoning warnings (scripts/quality_harness.py).
APP_QUALITY_REASONING_MODELS=qwen38-27b
APP_QUALITY_REASONING_MIN_TOKENS=2048

# Optional model registry. Keep this on one line. The client-facing "model"
# may be stable while "backend_model" changes to match the served checkpoint.
APP_MODELS_CONFIG=[{"model":"qwen38-27b","backend_model":"qwen3.8-27b","provider":"openai","base_url":"http://<sglang-host>:30000/v1","context_window":262144,"max_output_tokens":8192}]

# vLLM alternate/historical backend example (commented out).
# Uncomment and replace placeholders when routing to a local vLLM server.
# APP_MODELS_CONFIG_VLLM=[{"model":"qwen36","backend_model":"<served-vllm-checkpoint>","provider":"vllm","base_url":"http://localhost:8000/v1","context_window":131072,"max_output_tokens":8192}]
