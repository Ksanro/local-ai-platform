# vLLM provider configuration. These variables are read directly by
# packages/providers/vllm.py.
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=empty
REQUEST_TIMEOUT=120
DEFAULT_MODEL=qwen36

# Gateway settings. These variables are read by Pydantic Settings with the
# APP_ prefix.
APP_LOG_LEVEL=INFO
APP_DEFAULT_PROVIDER=vllm
APP_DEFAULT_MODEL=qwen36
APP_REPOSITORY_PATH=.
APP_REPOSITORY_CONTEXT_ENABLED=true
APP_REPOSITORY_CONTEXT_MAX_TOKENS=4096
APP_REPOSITORY_CONTEXT_INTENT_BUDGETS=SEARCH:2048,TEST:3072,DEBUG:4096,REFACTOR:4096,IMPLEMENT:4096,EXPLAIN:8192
APP_REPOSITORY_EXCLUDE_TESTS=false
APP_REPOSITORY_EXCLUDE_GLOBS=scripts/**
APP_CONTEXT_DELTA_INJECTION=true
APP_CONTEXT_DELTA_CACHE_SIZE=256
APP_SESSION_LOG_ENABLED=true
APP_SESSION_LOG_PATH=logs/sessions.jsonl
APP_HISTORY_CAP_ENABLED=true
APP_HISTORY_CAP_TOKENS=10000

# Optional model registry. Keep this on one line. The client-facing "model"
# may be stable while "backend_model" changes to match the served checkpoint.
APP_MODELS_CONFIG=[{"model":"qwen36","backend_model":"backend/model/name","provider":"vllm","base_url":"http://localhost:8000/v1","context_window":131072,"max_output_tokens":8192}]
